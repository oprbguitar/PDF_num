{
  "manifest_version": 3,
  "name": "PDF Studio — organizar, editar y foliar",
  "short_name": "PDF Studio",
  "version": "0.2.0",
  "description": "Combina, reordena, edita y folia PDF sin conexión. Los documentos nunca salen de tu equipo.",
  "default_locale": "es",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Abrir PDF Studio", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "js/background.js" },
  "permissions": ["sidePanel"],
  "commands": {
    "open-editor": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "Abrir el editor de pantalla completa" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
